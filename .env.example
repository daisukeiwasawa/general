# ETC利用照会サービス
ETC_USER_ID=your_user_id
ETC_PASSWORD=your_password

# Gmail
GMAIL_ADDRESS=sender@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# 送信先（カンマ区切りで複数可）
MAIL_TO=recipient@example.com

# LINE Messaging API（scripts/line_send.py で使用）
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token
# 送信先のユーザーID/グループID。未設定の場合は友だち全員へ broadcast する
LINE_TO=

# --- イトーキ配送の日次売上計上（scripts/itoki_daily.py で使用）---
# 配車表PDFを読み取るための Claude API キー
ANTHROPIC_API_KEY=

# 代入さまのメールが届くメールボックス（IMAP）
ITOKI_IMAP_HOST=imap.gmail.com
ITOKI_IMAP_USER=daisuke.iwasawa@elelogi.com
ITOKI_IMAP_PASSWORD=xxxx xxxx xxxx xxxx
ITOKI_MAIL_SENDER=takeshi_dainyu@nexus-infogate.co.jp

# スプレッドシート側に置いた Apps Script ウェブアプリ
SHEET_WEBAPP_URL=https://script.google.com/macros/s/xxxxx/exec
SHEET_WEBAPP_TOKEN=

# シフト表のドライバー名 → LINE ユーザーID
LINE_MENTION_MAP={"宮野顕":"U...","一瀬修一":"U...","岩澤大輔":"U..."}
# シフト表を引けなかったときの既定のメンション先（カンマ区切り）
LINE_MENTION_IDS=

# 任意。あれば道のりを Google Maps で正確に測る
GOOGLE_MAPS_API_KEY=
