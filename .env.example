# ETC利用照会サービス
ETC_USER_ID=your_user_id
ETC_PASSWORD=your_password

# Gmail
GMAIL_ADDRESS=sender@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# 送信先（カンマ区切りで複数可）
MAIL_TO=recipient@example.com

# LINE Messaging API（scripts/line_send.py で使用）
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token
# 送信先のユーザーID/グループID。未設定の場合は友だち全員へ broadcast する
LINE_TO=
